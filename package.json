{
  "name": "elasticvue",
  "private": true,
  "version": "1.17.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build",
    "tsc": "tsc --noEmit && vue-tsc",
    "lint": "eslint src tests --fix",
    "lint:style": "stylelint \"src/**/*.{css,scss}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,scss}\"",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest watch tests/unit",
    "test:e2e": "playwright test --project=chromium --project=chromium-docker",
    "test:e2e:all": "playwright test",
    "test:e2e:watch": "PWTEST_WATCH=1 playwright test --project=chromium --project=chromium-docker",
    "test:e2e:report": "playwright show-report",
    "ci": "npm run format && npm run lint && npm run lint:style && npm run tsc && npm run build && npm run test:unit && npm run test:e2e:all",
    "tauri:dev": "env GDK_BACKEND=x11 tauri dev",
    "tauri:build": "tauri build",
    "bundle:report": "vite-bundle-visualizer"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@fontsource/inter": "^5.3.0",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@lezer/highlight": "^1.2.5",
    "@quasar/extras": "^2.1.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "aws4fetch": "^1.0.20",
    "chart.js": "^4.6.1",
    "codemirror": "^6.0.2",
    "idb": "^8.0.4",
    "lossless-json": "^4.3.3",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pretty-bytes": "^7.2.0",
    "quasar": "^2.35.2",
    "strip-json-comments": "^5.0.3",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-resizable": "^2.1.7",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@quasar/vite-plugin": "^2.0.2",
    "@tauri-apps/cli": "2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
