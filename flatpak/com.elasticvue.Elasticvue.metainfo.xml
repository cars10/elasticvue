      <caption>Dashboard with cluster health and metrics</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/cars10/elasticvue/master/flatpak/screenshots/indices.png</image>
      <caption>Index management</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/cars10/elasticvue/master/flatpak/screenshots/search.png</image>
      <caption>Search your documents</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/cars10/elasticvue/master/flatpak/screenshots/rest.png</image>
      <caption>REST interface</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="1.17.0" date="2026-10-28">
      <url type="details">https://github.com/cars10/elasticvue/releases/tag/v1.17.0</url>
    </release>
  </releases>
</component>
